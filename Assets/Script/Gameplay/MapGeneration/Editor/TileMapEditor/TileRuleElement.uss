.tilerule-element__container{
    width: 300px;
    height: 300px;
    margin-left: auto;
    margin-right: auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    --cell-size: 100px;
    border-radius: var(--unity-metrics-default-border_radius);
    border-width: 1px;
    background-color: var(--unity-colors-default-background);
    border-color: var(--unity-colors-default-border);
}



.row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.spacer {
    width: var(--cell-size);
    height: var(--cell-size);
}

.tilerule-element__cell {
    width: var(--cell-size);
    height: var(--cell-size);
    border-radius: var(--unity-metrics-default-border_radius);
    border-width: 1px;
    background-color: var(--unity-colors-default-background);
    border-color: var(--unity-colors-default-border);
    display: flex;
} 

    .tilerule-element__cell:hover {
        background-color: var(--unity-colors-button-background-hover);
    }

    .tilerule-element__cell:focus {
        background-color: var(--unity-colors-button-background-focus);
        border-color: var(--unity-colors-button-border-focus);
    }



